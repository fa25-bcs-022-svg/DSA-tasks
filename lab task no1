#include <iostream>
using namespace std;

int main()
{
    int start, stop;
    long long sum = 0;

    cout << "Enter starting value: ";
    cin >> start;

    cout << "Enter stopping value: ";
    cin >> stop;

    // Calculate sum of squares
    for (int x = start; x <= stop; x++)
    {
        sum = sum + (x * x);
    }

    cout << "\nSum of X^2 = " << sum << endl;

    return 0;
}







