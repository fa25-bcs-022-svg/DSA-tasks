#include <iostream>
using namespace std;

const int MAX_SIZE = 100;

class ArrayList
{
private:
    int arr[MAX_SIZE];
    int size;

public:
    // Constructor
    ArrayList()
    {
        size = 0;
    }

    // Insert value at end
    void insertAtEnd(int value)
    {
        if (size == MAX_SIZE)
        {
            cout << "List is full!" << endl;
            return;
        }

        arr[size] = value;
        size++;
    }

    // Display list
    void display()
    {
        if (size == 0)
        {
            cout << "List is empty!" << endl;
            return;
        }

        cout << "Array List: ";

        int i = 0;

        while (i < size)
        {
            cout << arr[i] << " ";
            i++;
        }

        cout << endl;
    }

    // Linear Search using while loop
    int linearSearch(int value)
    {
        int i = 0;

        while (i < size)
        {
            if (arr[i] == value)
            {
                return i;
            }

            i++;
        }

        return -1;
    }
};

int main()
{
    ArrayList list;

    int n;
    int value;
    int searchValue;
    int result;

    cout << "How many values do you want to enter? ";
    cin >> n;

    if (n > MAX_SIZE)
    {
        cout << "Maximum size is " << MAX_SIZE << "." << endl;
        return 0;
    }

    // Input values
    for (int i = 0; i < n; i++)
    {
        cout << "Enter value " << i + 1 << ": ";
        cin >> value;

        list.insertAtEnd(value);
    }

    cout << "\n";
    list.display();

    // Search value
    cout << "\nEnter value to search: ";
    cin >> searchValue;

    result = list.linearSearch(searchValue);

    if (result != -1)
    {
        cout << "Value " << searchValue
             << " found at index " << result << "." << endl;
        cout << "Position in list: " << result + 1 << "." << endl;
    }
    else
    {
        cout << "Value " << searchValue
             << " was not found in the list." << endl;
    }

    return 0;
}
